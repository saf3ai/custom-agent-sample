# Copy to .env for local runs. In the cloud, set these as environment variables
# and keep every *_KEY / *_TOKEN in the platform's secret store.

# ---------------------------------------------------------------- Saf3AI
# Organization API key: Saf3AI console > Integrations > SDK > Custom Agent SDK
SAF3AI_API_KEY=
SAF3AI_COLLECTOR_AGENT=https://analyzer.saf3ai.com/v1/traces
SAF3AI_SCANNER_ENDPOINT=https://scanner.saf3ai.com
SAF3AI_AGENT_ID=sample-support-agent
SAF3AI_SERVICE_NAME=sample-support-agent
SAF3AI_ENVIRONMENT=production

# block   = unsafe prompts are stopped before the LLM is called (HTTP 403)
# monitor = everything is allowed; detections still show in the console
SAF3AI_ENFORCEMENT=block
# What to do if the scanner cannot be reached: open = allow, closed = block
SAF3AI_FAIL_MODE=open
# Also block unsafe model replies (adds one scan call per turn)
SAF3AI_BLOCK_RESPONSES=false

# Data capture switches (default true)
# SAF3AI_CAPTURE_RESPONSES=false    # do not store model replies in traces
# SAF3AI_CLIENT_DATA_CAPTURE=false  # do not capture client IP / user agent

# ---------------------------------------------------------------- LLM
# gemini | vertex | anthropic | openai | azure-openai | bedrock |
# huggingface | openai-compatible | mock
LLM_PROVIDER=mock
# Model / deployment id. Defaults: gemini -> gemini-flash-latest, vertex -> gemini-2.5-flash,
# anthropic -> claude-opus-5, openai -> gpt-4.1-mini, bedrock -> amazon.nova-lite-v1:0,
# huggingface -> openai/gpt-oss-20b. Required for azure-openai (deployment name) and
# openai-compatible.
LLM_MODEL=

# gemini (Google AI Studio key)
GEMINI_API_KEY=

# vertex (uses the workload's service account - no key)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# anthropic (Claude API key)
ANTHROPIC_API_KEY=

# openai
OPENAI_API_KEY=

# azure-openai (LLM_MODEL = deployment name)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# bedrock (uses the workload's IAM role - no key; LLM_MODEL = model or inference-profile id)
AWS_REGION=us-east-1

# huggingface (Inference Providers token)
HF_TOKEN=

# openai-compatible (vLLM, Ollama, Groq, Together, ...)
OPENAI_BASE_URL=
