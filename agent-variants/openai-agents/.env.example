# Copy to .env for local runs. In the cloud, set these as environment variables
# and keep every *_KEY / *_TOKEN in the platform's secret store.

# ---------------------------------------------------------------- Saf3AI
# Organization API key: Saf3AI console > Integrations > SDK > Custom Agent SDK
SAF3AI_API_KEY=
SAF3AI_COLLECTOR_AGENT=https://analyzer.saf3ai.com/v1/traces
SAF3AI_SCANNER_ENDPOINT=https://scanner.saf3ai.com
SAF3AI_AGENT_ID=sample-support-agent-openai-agents
SAF3AI_SERVICE_NAME=sample-support-agent-openai-agents
SAF3AI_ENVIRONMENT=production

# block   = unsafe prompts are stopped before the LLM is called (HTTP 403)
# monitor = everything is allowed; detections still show in the console
SAF3AI_ENFORCEMENT=block
# What to do if the scanner cannot be reached: open = allow, closed = block
SAF3AI_FAIL_MODE=open
# Also block unsafe model replies (adds one scan call per turn)
SAF3AI_BLOCK_RESPONSES=false

# Data capture switches (default true)
# SAF3AI_CAPTURE_RESPONSES=false    # do not store model replies in traces
# SAF3AI_CLIENT_DATA_CAPTURE=false  # do not capture client IP / user agent

# ---------------------------------------------------------------- LLM (OpenAI)
OPENAI_API_KEY=
# Model id. Empty = the Agents SDK default model
LLM_MODEL=
# The Agents SDK also sends its own traces to OpenAI by default. To turn that off:
# OPENAI_AGENTS_DISABLE_TRACING=true
