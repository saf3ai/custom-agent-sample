# Copy to .env for local runs. In the cloud, set these as environment variables
# and keep every *_KEY / *_TOKEN in the platform's secret store.

# ---------------------------------------------------------------- Saf3AI
# Organization API key: Saf3AI console > Integrations > SDK > Custom Agent SDK
SAF3AI_API_KEY=
SAF3AI_COLLECTOR_AGENT=https://analyzer.saf3ai.com/v1/traces
SAF3AI_SCANNER_ENDPOINT=https://scanner.saf3ai.com
# The agent name the event shows under in the console. Use a new one per event.
SAF3AI_AGENT_ID=saf3ai-ctf-shopbot
SAF3AI_ENVIRONMENT=production
# What to do on levels 4-5 if the scanner cannot be reached: open = allow, closed = block
SAF3AI_FAIL_MODE=open

# ---------------------------------------------------------------- CTF
# Protects the organiser page (/admin) and the answer key. Long and random, 12+ characters.
CTF_ADMIN_TOKEN=
# Players type this to join. Leave empty to let anyone with the link join.
CTF_JOIN_CODE=
# Flags are derived from this value. Leave empty for random flags, kept in the data folder.
CTF_FLAG_SEED=
# Event length used by the Start button when no other value is given
CTF_MINUTES=60
# Limits per team: seconds between messages, messages in the whole event, characters per message
CTF_MIN_GAP_SECONDS=3
CTF_MAX_MESSAGES=200
CTF_MAX_CHARS=800
# Longest reply the model may write, in tokens
CTF_MAX_REPLY_TOKENS=400
# Agent turns that can run at the same time (worker processes). Plan one for every three teams.
CTF_WORKERS=4
# Where the scores are kept (SQLite). In the container this is /data: mount a volume there.
# CTF_DATA_DIR=./data

# ---------------------------------------------------------------- LLM
# google-genai | openai | anthropic | bedrock
LLM_PROVIDER=google-genai
# Model id. Default for google-genai: gemini-flash-lite-latest. Required for the others.
LLM_MODEL=

# google-genai (Gemini API key)
GOOGLE_API_KEY=

# openai
OPENAI_API_KEY=

# anthropic
ANTHROPIC_API_KEY=

# bedrock: no key. Uses the AWS credentials of the host (for example the EC2 instance role).
# LLM_MODEL=us.amazon.nova-2-lite-v1:0
# AWS_DEFAULT_REGION=us-east-1
