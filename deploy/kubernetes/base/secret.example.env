# Copy to secret.env (same folder) and fill in:  cp secret.example.env secret.env
# secret.env is gitignored. It becomes Secret "saf3ai-agent-secrets".
# Keep only the lines you need. No empty values.

# Saf3AI console > Integrations > SDK > Custom Agent SDK
SAF3AI_API_KEY=<SAF3AI_API_KEY>

# The key for your LLM_PROVIDER. Not needed for bedrock (EKS) or vertex (GKE):
# those use the pod's cloud identity.
# GEMINI_API_KEY=<GEMINI_API_KEY>
# ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
# OPENAI_API_KEY=<OPENAI_API_KEY>
# AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>
# HF_TOKEN=<HF_TOKEN>
