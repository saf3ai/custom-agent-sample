# Non-secret settings -> ConfigMap "saf3ai-agent-config".
# Every option is described in agent/.env.example (kit root).
# Do not add a line with an empty value (e.g. "LLM_MODEL="): an empty value
# overrides the agent's built-in default.

SAF3AI_COLLECTOR_AGENT=https://analyzer.saf3ai.com/v1/traces
SAF3AI_SCANNER_ENDPOINT=https://scanner.saf3ai.com
SAF3AI_AGENT_ID=sample-support-agent
SAF3AI_SERVICE_NAME=sample-support-agent
SAF3AI_ENVIRONMENT=production

# block = unsafe prompts get HTTP 403 before the LLM is called; monitor = detect only
SAF3AI_ENFORCEMENT=block
# Scanner unreachable: open = allow, closed = block
SAF3AI_FAIL_MODE=open
SAF3AI_BLOCK_RESPONSES=false

# mock = no LLM key needed (smoke test). Each overlay sets its cloud's LLM.
LLM_PROVIDER=mock

# One agent turn runs at a time per process. Scale with replicas (preferred)
# or more worker processes per pod (raise the memory limit to match).
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
